{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Cohort-safe user profile without PII (email and rollNumber are isolated in private subcollection).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "enum": ["student", "mentor", "admin"]
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "semester": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "xp": {
          "type": "number"
        },
        "level": {
          "type": "number"
        },
        "streak": {
          "type": "number"
        },
        "simulatedCgpa": {
          "type": "number"
        },
        "totalLevelsCompleted": {
          "type": "number"
        },
        "isCohortVisible": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "role",
        "department",
        "semester",
        "xp",
        "level",
        "streak",
        "simulatedCgpa",
        "totalLevelsCompleted",
        "isCohortVisible",
        "createdAt",
        "updatedAt"
      ]
    },
    "PrivateAccountInfo": {
      "title": "PrivateAccountInfo",
      "description": "Strictly isolated PII for an authenticated user (email, roll number, provider).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "rollNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "authProvider": {
          "type": "string",
          "enum": ["google", "password"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "rollNumber", "authProvider", "createdAt", "updatedAt"]
    },
    "UserNexusProgress": {
      "title": "UserNexusProgress",
      "description": "Cloud-synced MAKAUT Nexus 3D progression state for a single user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "xp": {
          "type": "number"
        },
        "streak": {
          "type": "number"
        },
        "lastActiveDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "completedLevels": {
          "type": "object"
        },
        "bestScores": {
          "type": "object"
        },
        "aptitudeBestScore": {
          "type": "number"
        },
        "aptitudeAttempts": {
          "type": "number"
        },
        "interviewShieldsCleared": {
          "type": "array"
        },
        "activityLog": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "xp",
        "streak",
        "lastActiveDate",
        "completedLevels",
        "bestScores",
        "aptitudeBestScore",
        "aptitudeAttempts",
        "interviewShieldsCleared",
        "activityLog",
        "updatedAt"
      ]
    },
    "ProjectBlueprint": {
      "title": "ProjectBlueprint",
      "description": "Saved Capstone Project Forge blueprint.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "domain": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "difficulty": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "problemStatement": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1200
        },
        "proposedSolution": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1500
        },
        "coreFeatures": {
          "type": "array"
        },
        "techStack": {
          "type": "array"
        },
        "roadmap": {
          "type": "array"
        },
        "extensions": {
          "type": "array"
        },
        "source": {
          "type": "string",
          "enum": ["gemini", "local"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "title",
        "domain",
        "difficulty",
        "problemStatement",
        "proposedSolution",
        "coreFeatures",
        "techStack",
        "roadmap",
        "extensions",
        "source",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPyqHistory": {
      "title": "UserPyqHistory",
      "description": "User-generated PYQ 3D lab history with optional Firebase Storage image reference.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "subjectCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "questionText": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1500
        },
        "templateType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "storagePath": {
          "type": "string",
          "maxLength": 300
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 600
        },
        "config": {
          "type": "object"
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "title",
        "subjectCode",
        "questionText",
        "templateType",
        "storagePath",
        "imageUrl",
        "config",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "DsaSubmission": {
      "title": "DsaSubmission",
      "description": "Student DSA Logic-to-Code written code and review summary.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "problemId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 80
        },
        "language": {
          "type": "string",
          "enum": ["python", "cpp", "java", "c"]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "matchScore": {
          "type": "number"
        },
        "verdict": {
          "type": "string",
          "enum": ["aligned", "matched", "partial", "needs-work", "draft"]
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "problemId", "language", "code", "matchScore", "verdict", "summary", "updatedAt"]
    },
    "CuratedPyqLab": {
      "title": "CuratedPyqLab",
      "description": "Mentor or Admin published official MAKAUT PYQ 3D Lab shared across all students.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "authorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "subjectCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "questionText": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1500
        },
        "storagePath": {
          "type": "string",
          "maxLength": 300
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 600
        },
        "config": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": ["published", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authorId",
        "authorName",
        "title",
        "subjectCode",
        "questionText",
        "storagePath",
        "imageUrl",
        "config",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "MentorRoleRequest": {
      "title": "MentorRoleRequest",
      "description": "Role upgrade request submitted during account creation or profile settings for Mentor privileges.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "facultyCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "justification": {
          "type": "string",
          "minLength": 4,
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "department",
        "facultyCode",
        "justification",
        "status",
        "reviewedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin lookup registry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/user_profiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Cohort-safe user profiles storing role, academic metadata, and XP/CGPA telemetry."
    },
    "/users/{userId}/private/account": {
      "schema": { "$ref": "#/entities/PrivateAccountInfo" },
      "description": "Owner-only private PII document storing email and MAKAUT roll number."
    },
    "/users/{userId}/progress/nexus": {
      "schema": { "$ref": "#/entities/UserNexusProgress" },
      "description": "Owner-only synced game mastery, aptitude, interview, and activity logs."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectBlueprint" },
      "description": "Owner-only saved Capstone Project Forge blueprints."
    },
    "/users/{userId}/pyq_history/{labId}": {
      "schema": { "$ref": "#/entities/UserPyqHistory" },
      "description": "Owner-only generated PYQ 3D lab history with Firebase Storage photo links."
    },
    "/users/{userId}/dsa_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/DsaSubmission" },
      "description": "Owner-only DSA Logic-to-Code practice code and review summaries."
    },
    "/curated_pyqs/{pyqId}": {
      "schema": { "$ref": "#/entities/CuratedPyqLab" },
      "description": "Official Mentor/Admin curated PYQ 3D labs readable by all signed-in students."
    },
    "/mentor_requests/{userId}": {
      "schema": { "$ref": "#/entities/MentorRoleRequest" },
      "description": "Pending and reviewed Mentor role escalation requests."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted Admin role lookup documents."
    }
  }
}
