rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');
    }

    // Student / User PYQ Question Image Vault
    match /pyq-uploads/{userId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImageUpload();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Mentor / Admin Official Curated PYQ Attachments
    match /curated-pyqs/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImageUpload();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
